JWT_SECRET_KEY=your-secret-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENAI_API_KEY=your-openai-api-key
CUSTOM_API_KEY=your-custom-api-key

# Elasticsearch 全文检索
ES_ENABLED=true
ES_URL=http://localhost:9200
ES_INDEX=devflow_documents
RAG_HYBRID_ENABLED=true

# 联网搜索（博查 Bocha）
WEB_SEARCH_ENABLED=true
BOCHA_API_KEY=your-bocha-api-key

# Deployment mode (true = run behind gateway, backend on localhost:8001)
BEHIND_GATEWAY=true
# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
# LLM concurrency
LLM_CONCURRENCY_LIMIT=5
# RAG anti-hallucination
RAG_RELEVANCE_THRESHOLD=0.45
RAG_TOP_K=6
# Intent guard (prompt injection defense)
INTENT_GUARD_ENABLED=true
INTENT_GUARD_REGEX_ENABLED=true
INTENT_GUARD_LLM_ENABLED=true
INTENT_GUARD_LLM_TIMEOUT_MS=500

# ---------------------------------------------------------------------------
# Agent Harness（风控策略运维运行时）
# 所有配置也可直接写在 config/settings.yaml 的 harness: 段
# ---------------------------------------------------------------------------
HARNESS_ENABLED=true
# 关闭后强制确定性回退，不发起 LLM 请求（离线演示 / CI）
HARNESS_LLM_ENABLED=true
HARNESS_WORKSPACE_ROOT=data/harness
HARNESS_SKILLS_DIR=skills
HARNESS_MAX_PARALLEL_SUBAGENTS=4
HARNESS_MAX_TASKS=12
HARNESS_MAX_TOOL_ITERATIONS=6
HARNESS_RUN_TIMEOUT_SECONDS=1800

# 上下文预算（控制主 Agent 上下文污染）
HARNESS_CONTEXT_BUDGET_TOKENS=24000
HARNESS_SUMMARY_MAX_CHARS=1200

# 短期记忆（Redis）与长期记忆（Milvus）
HARNESS_MEMORY_TTL=86400
HARNESS_MEMORY_TOP_K=5
HARNESS_MEMORY_DISTILL=true
HARNESS_MILVUS_ENABLED=true
HARNESS_MILVUS_URI=http://localhost:19530
HARNESS_MILVUS_COLLECTION=harness_memories
HARNESS_MILVUS_DIM=1024

# 沙箱：生产必须使用 opensandbox；local 仅开发/降级
HARNESS_SANDBOX_ENABLED=true
HARNESS_SANDBOX_PROVIDER=opensandbox
HARNESS_SANDBOX_BASE_URL=http://127.0.0.1:8080
HARNESS_SANDBOX_API_KEY=
HARNESS_SANDBOX_NAMESPACE=default
HARNESS_SANDBOX_TIMEOUT=60
HARNESS_SANDBOX_ALLOW_NETWORK=false

# 人工审批：高风险动作必须审批；开发可把 sandbox.exec 放入自动放行
HARNESS_APPROVALS_ENABLED=true
HARNESS_APPROVAL_TTL=1800
HARNESS_AUTO_APPROVE_ACTIONS=
HARNESS_REQUIRED_APPROVAL_ACTIONS=rule.publish,rule.gray_release,sandbox.exec,file.promote,policy.write,java.tool.invoke

# 链路追踪：Kafka 不可用时自动落 data/harness/audit
HARNESS_TRACING_ENABLED=true
HARNESS_KAFKA_ENABLED=true
HARNESS_KAFKA_BOOTSTRAP=localhost:9092
HARNESS_KAFKA_AUDIT_TOPIC=harness.audit
HARNESS_KAFKA_TRACE_TOPIC=harness.trace

# 外部数据采集（web_search 复用 BOCHA_API_KEY；web_fetch 抓取网页正文）
HARNESS_WEB_ENABLED=true
HARNESS_WEB_FETCH_ENABLED=true
HARNESS_WEB_TIMEOUT=20
HARNESS_WEB_MAX_BYTES=2000000
HARNESS_WEB_MAX_CHARS=12000
HARNESS_WEB_MAX_REDIRECTS=3
HARNESS_WEB_ALLOWED_DOMAINS=
HARNESS_WEB_BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0,::1
HARNESS_WEB_ALLOWED_PORTS=80,443
HARNESS_WEB_USER_AGENT=AgentHarness/1.0 (+risk-strategy-ops)
HARNESS_WEB_CACHE_TTL=900
HARNESS_WEB_MAX_SOURCES=8
HARNESS_WEB_OFFLINE_FALLBACK=true

# Java 工具扩展桥
HARNESS_JAVA_BRIDGE_ENABLED=false
HARNESS_JAVA_BASE_URL=http://127.0.0.1:8081
HARNESS_JAVA_SHARED_SECRET=
# 逗号分隔的管理员用户名（拥有 risk_admin 角色）
HARNESS_ADMIN_USERS=
# 可选：覆盖角色禁用动作（JSON），例如 {"viewer":["rule.publish"]}
# HARNESS_ROLE_DENY={"viewer":["rule.publish","sandbox.exec"]}
