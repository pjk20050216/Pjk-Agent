JWT_SECRET_KEY=your-secret-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENAI_API_KEY=your-openai-api-key
CUSTOM_API_KEY=your-custom-api-key

# Elasticsearch 全文检索
ES_ENABLED=true
ES_URL=http://localhost:9200
ES_INDEX=devflow_documents
RAG_HYBRID_ENABLED=true

# 联网搜索（博查 Bocha）
WEB_SEARCH_ENABLED=true
BOCHA_API_KEY=your-bocha-api-key

# Deployment mode (true = run behind gateway, backend on localhost:8001)
BEHIND_GATEWAY=true
# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
# LLM concurrency
LLM_CONCURRENCY_LIMIT=5
# RAG anti-hallucination
RAG_RELEVANCE_THRESHOLD=0.45
RAG_TOP_K=6
# Intent guard (prompt injection defense)
INTENT_GUARD_ENABLED=true
INTENT_GUARD_REGEX_ENABLED=true
INTENT_GUARD_LLM_ENABLED=true
INTENT_GUARD_LLM_TIMEOUT_MS=500
